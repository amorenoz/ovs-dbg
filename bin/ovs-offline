#!/bin/bash
set -eu

SCRIPT=`realpath -s $0`
SCRIPT_PATH=`dirname $SCRIPT`
CONTAINER_PATH=${SCRIPT_PATH}/../containers/ovs-offline

OVN_NAMESPACE=ovn-kubernetes
WORKDIR=${OVS_DBG_WORKDIR:-/tmp/ovs-offline}
VAR_RUN=${WORKDIR}/var-run
SOS_DIR=${WORKDIR}/sos_report
SOS_CMD_DIR=${SOS_DIR}/sos_commands/openvswitch/
SOURCE_DIR=${WORKDIR}/bin
RESTORE_FLOWS_DIR=${WORKDIR}/restore_flows
EXTRACTED_RPMS_DIR=${WORKDIR}/extracted_rpms
CONTAINER_CMD=podman
RPM_PATHS=""
OVS_REPO=${OVS_DBG_REPO:-https://github.com/openvswitch/ovs.git}
OVS_COMMIT=${OVS_DBG_COMMIT:-branch-2.15}

OVN_DB_LOCATIONS="var/lib/openvswitch/ovn usr/local/etc/openvswitch etc/openvswitch etc/ovn var/lib/openvswitch var/lib/ovn/etc var/lib/ovn-ic/etc"


declare -A open_flow_protocols=(
    [0x1]=OpenFlow10
    [0x2]=OpenFlow11
    [0x3]=OpenFlow12
    [0x4]=OpenFlow13
    [0x5]=OpenFlow14
    [0x6]=OpenFlow15
)

usage() {
    echo "$0 [OPTIONS] COMMAND [COMMAND_OPTIONS]"
    echo ""
    echo "Debug OVS by recreating an environment offline"
    echo ""
    echo "Basic commands:"
    echo "  build                Builds the needed container images"
    echo "    Options":
    echo "       -r:    Set ovs git-repo to clone source code from. Also configurable via OVS_DBG_REPO env var.  Default: ${OVS_REPO}"
    echo "       -c:    Set commit/branch to git checkout. Also configurable via OVS_DBG_COMMIT env var.         Default: ${OVS_COMMIT}"
    echo "       -n:    Build without using cache (i.e. to rebuild a repo/branch with new changes)"
    echo ""
    echo "  start                Starts an offline debugging session service. Data must have been previously collected in the working directory"
    echo "    Options":
    echo "       -s:    Run in standalone mode (directly on host, no containers)"
    echo "       -r:    Path to RPM file(s) to extract and use for OVS binaries (standalone mode only)"
    echo ""
    echo "  stop                 Stops the offline debugging environment"
    echo ""
    echo "  show                 Prints the available information found in the working directory"
    echo ""
    echo " Data collection commands"
    echo "  collect-k8s NODE     Collects information from a running k8s node and saves it in the working directory"
    echo "    Options":
    echo "       -o:    Openshift environment"
    echo ""
    echo "  collect-sos-ovs      SOS      Collects the OpenvSwitch information from the provided sos archive or directory and prepares it for offline debugging"
    echo "  collect-sos-ovn      SOS      Collects the OVN information from the provided sos archive or directory and prepares it for offline debugging"
    echo ""
    echo "  collect-db-ovs       DBFILE   Collects the provided OpenvSwitch database file and prepares it for offline debugging"
    echo "  collect-db-ovn-nb    DBFILE   Collects the provided OVN_Northbound database file and prepares it for offline debugging"
    echo "  collect-db-ovn-sb    DBFILE   Collects the provided OVN_Southbound database file and prepares it for offline debugging"
    echo ""
    echo ""
    echo "Generic options"
    echo "  -h:     Print help"
    echo "  -w:     Set working directory. Also configurable via OVS_DBG_WORKDIR env var. Default: /tmp/ovs-offline"
    echo "  -d:     Set debug mode"
}

# Logging functions with emojis for better user experience
log_info() {
    echo "💡 $@"
}

log_success() {
    echo "✅ $@"
}

log_warning() {
    echo "⚠️  $@"
}

log_error() {
    echo "❌ Error: $@"
    exit 1
}

log_status() {
    echo "🔄 $@"
}

log_complete() {
    echo ""
    echo "🎉 $@"
}

# Legacy error function for compatibility
error() {
    log_error "$@"
}

extract_rpms() {
    # Extract RPM files to workdir for standalone mode
    # $1: space-separated list of RPM file paths
    local rpm_paths="$1"

    if [ -z "$rpm_paths" ]; then
        return 0
    fi

    log_status "Extracting RPM packages for standalone mode"

    # Create extraction directory
    mkdir -p "$EXTRACTED_RPMS_DIR"

    # Extract each RPM
    for rpm_path in $rpm_paths; do
        if [ ! -f "$rpm_path" ]; then
            log_error "RPM file not found: $rpm_path"
        fi

        log_status "Extracting $(basename "$rpm_path")"

        # Use rpm2cpio and cpio to extract without running post-install scripts
        if command -v rpm2cpio >/dev/null 2>&1; then
            (cd "$EXTRACTED_RPMS_DIR" && rpm2cpio "$rpm_path" | cpio -idm 2>/dev/null)
        elif command -v rpm >/dev/null 2>&1; then
            # Alternative: use rpm command if rpm2cpio not available
            (cd "$EXTRACTED_RPMS_DIR" && rpm2cpio "$rpm_path" | cpio -idm 2>/dev/null)
        else
            log_error "Neither rpm2cpio nor rpm command found. Cannot extract RPM files."
        fi

        if [ $? -eq 0 ]; then
            log_success "Successfully extracted $(basename "$rpm_path")"
        else
            log_error "Failed to extract $(basename "$rpm_path")"
        fi
    done

    # Verify that we have the required OVS binaries
    local required_binaries="ovsdb-server ovsdb-tool ovs-vswitchd ovs-vsctl"
    local found_binaries=""

    for binary in $required_binaries; do
        # Look for the binary in common locations within the extracted files
        if find "$EXTRACTED_RPMS_DIR" -name "$binary" -type f -executable 2>/dev/null | head -1 >/dev/null; then
            found_binaries="$found_binaries $binary"
        fi
    done

    if [ -n "$found_binaries" ]; then
        log_success "Found OVS binaries in extracted RPMs:$found_binaries"

        # Set up library path for extracted binaries
        setup_rpm_library_path
    else
        log_warning "No OVS binaries found in extracted RPMs. Will fall back to system binaries."
    fi
}

get_ld_library_path() {
    # Set up LD_LIBRARY_PATH to include library directories from extracted RPMs
    if [ ! -d "$EXTRACTED_RPMS_DIR" ]; then
        return 0
    fi

    local lib_paths=""
    local common_lib_dirs="usr/lib64 usr/lib lib64 lib usr/local/lib64 usr/local/lib"

    for lib_dir in $common_lib_dirs; do
        local full_lib_path="$EXTRACTED_RPMS_DIR/$lib_dir"
        if [ -d "$full_lib_path" ]; then
            if [ -z "$lib_paths" ]; then
                lib_paths="$full_lib_path"
            else
                lib_paths="$lib_paths:$full_lib_path"
            fi
        fi
    done
    echo $lib_paths
}

setup_rpm_library_path() {
    lib_paths=$(get_ld_library_path)

    if [ -n "$lib_paths" ]; then
        if [ -n "${LD_LIBRARY_PATH:-}" ]; then
            export LD_LIBRARY_PATH="$lib_paths:$LD_LIBRARY_PATH"
        else
            export LD_LIBRARY_PATH="$lib_paths"
        fi
    fi
}

find_binary() {
    # Find a binary, preferring extracted RPM version over system version
    # $1: binary name
    local binary_name="$1"

    # First check if we have extracted RPMs and the binary exists there
    if [ -n "$RPM_PATHS" ] && [ -d "$EXTRACTED_RPMS_DIR" ]; then
        local extracted_binary=$(find "$EXTRACTED_RPMS_DIR" -name "$binary_name" -type f -executable 2>/dev/null | head -1)
        if [ -n "$extracted_binary" ]; then
            # Ensure LD_LIBRARY_PATH is set up for extracted binaries
            setup_rpm_library_path
            echo "$extracted_binary"
            return 0
        fi
    fi

    # Fall back to system binary
    local system_binary=$(command -v "$binary_name" 2>/dev/null)
    if [ -n "$system_binary" ]; then
        echo "$system_binary"
        return 0
    fi

    return 1
}

set_container_cmd() {
    # Auto-detect the available runtime.
    if command -v podman > /dev/null; then
        CONTAINER_CMD=podman
    elif command -v docker > /dev/null; then
        CONTAINER_CMD=docker
    else
            log_error "No container runtime detected. Please install 'podman' or 'docker'"
    fi
}

do_build() {
    set_container_cmd
    while getopts "r:c:n" opt; do
        case ${opt} in
            r)
                OVS_REPO=$OPTARG
                ;;
            c)
                OVS_COMMIT=$OPTARG
                ;;
            n)
                local cache_arg=--no-cache
                ;;
        esac
    done
    if test -f "${CONTAINER_PATH}/Dockerfile"; then
        ${CONTAINER_CMD} build --build-arg OVS_REPO=${OVS_REPO} --build-arg OVS_COMMIT=${OVS_COMMIT} -t ovs-offline -f ${CONTAINER_PATH}/Dockerfile ${CONTAINER_PATH}/../.. ${cache_arg-}
    else
        log_error "Cannot build the container locally. You may need to execute the script directly via \"/<GIT-REPO-PATH>/ovs-offline/bin/ovs-offline build\". Instead, quay.io/amorenoz/ovs-offline will be used by default."
    fi
}

stop_standalone_daemons() {
    log_status "Stopping standalone daemons..."
    
    # Stop ovs-vswitchd if running
    if [ -f "${VAR_RUN}/ovs/ovs-vswitchd.pid" ]; then
        local pid=$(cat "${VAR_RUN}/ovs/ovs-vswitchd.pid" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            log_status "Stopping ovs-vswitchd (PID: $pid)"
            kill "$pid" 2>/dev/null || true
            # Wait a bit and force kill if necessary
            sleep 2
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "${VAR_RUN}/ovs/ovs-vswitchd.pid"
    fi
    
    # Stop ovsdb servers
    for db_type in ovs ovn_nb ovn_sb; do
        local pidfile="${VAR_RUN}/${db_type}/ovsdb-server.pid"
        if [ -f "$pidfile" ]; then
            local pid=$(cat "$pidfile" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                log_status "Stopping ovsdb-server for ${db_type} (PID: $pid)"
                kill "$pid" 2>/dev/null || true
                # Wait a bit and force kill if necessary
                sleep 1
                if kill -0 "$pid" 2>/dev/null; then
                    kill -9 "$pid" 2>/dev/null || true
                fi
            fi
            rm -f "$pidfile"
        fi
    done
}

do_stop() {
    if ! [ -z "${OVS_OFFLINE_ENV-}" ]; then
        log_error "Cannot stop, ovs-offline env is still active. Run \"ovs-offline-deactivate\" and try again"
    fi
    
    # Stop standalone daemons if any pidfiles exist
    if [ -d "${VAR_RUN}" ]; then
        stop_standalone_daemons
    fi
    
    # Stop containers
    set_container_cmd
    ${CONTAINER_CMD} kill ovs-vswitchd &>/dev/null || true
    ${CONTAINER_CMD} rm ovs-vswitchd &>/dev/null || true
    ${CONTAINER_CMD} kill ovsdb-server-ovs &>/dev/null || true
    ${CONTAINER_CMD} rm ovsdb-server-ovs &>/dev/null || true
    ${CONTAINER_CMD} kill ovsdb-server-ovn_nb &>/dev/null || true
    ${CONTAINER_CMD} rm ovsdb-server-ovn_nb &>/dev/null || true
    ${CONTAINER_CMD} kill ovsdb-server-ovn_sb &>/dev/null || true
    ${CONTAINER_CMD} rm ovsdb-server-ovn_sb &>/dev/null || true
    
    rm -rf ${WORKDIR}
}

do_collect-db() {
    # $1: database file to backup
    # $2: name of the database (ovs | ovn_nb | ovn_sb)
    local orig_dbfile=$1
    local name=$2

    local dest_dbfile=${WORKDIR}/db/${name}/$(basename -- ${orig_dbfile})

    if [ -f ${dest_dbfile} ]; then
        log_error "A database of type ${name} already exists in the current working directory. Run 'stop' or select a different working directory"
    fi

    mkdir -p ${WORKDIR}/db/${name}
    cp $orig_dbfile ${dest_dbfile}
}

do_collect-k8s() {
    OPTIND=1
    while getopts "oh" opt; do
        case ${opt} in
            h)
                usage
                exit 0
                ;;
            o)
                OVN_NAMESPACE=openshift-ovn-kubernetes
                ;;
        esac
    done
    shift $(((OPTIND -1)))

    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi
    NODE=$1
    kubectl get node $NODE &>/dev/null || log_error "Node not found"

    local ovnkube_node=$(kubectl get pods -n $OVN_NAMESPACE --field-selector spec.nodeName=$NODE -o name | head -1 | sed "s/^.\{4\}//")
    local container="ovnkube-controller"

    # Collect the flows and groups for future restoration using ovs-save
    bridges=$(kubectl exec -n $OVN_NAMESPACE $ovnkube_node -c $container -- ovs-vsctl -- --real list-br)
    kubectl exec -it -n $OVN_NAMESPACE $ovnkube_node -c $container -- sh -c "/usr/share/openvswitch/scripts/ovs-save save-flows $(echo $bridges | xargs) > /tmp/restore.sh"
    kubectl cp -n $OVN_NAMESPACE -c $container ${ovnkube_node}:/tmp/restore.sh ${RESTORE_FLOWS_DIR}/do_restore.sh 2>&1 | grep -v 'tar: Removing leading' || true >&2
    [ -f ${RESTORE_FLOWS_DIR}/do_restore.sh ] || log_error "Could not copy /tmp/restore.sh from ${ovnkube_node}"
    save_dir=$(cat ${RESTORE_FLOWS_DIR}/do_restore.sh | awk '/replace/{print $6; exit}' | xargs dirname)
    kubectl cp -n $OVN_NAMESPACE -c $container ${ovnkube_node}:${save_dir} ${RESTORE_FLOWS_DIR} 2>&1 | grep -v 'tar: Removing leading' || true >&2
    dump_count=`ls ${RESTORE_FLOWS_DIR}/*.dump 2>/dev/null | wc -l`
    if [ ${dump_count} -le 0 ]; then log_error "Could not copy $save_dir from ${ovnkube_node}"; fi

    cat <<EOF > ${RESTORE_FLOWS_DIR}/restore.sh
CURR_DIR=\$(dirname \$(realpath \$0))
ln -s \$CURR_DIR $save_dir
sh \$CURR_DIR/do_restore.sh
EOF
    # Currently, there is a bug in OVS (https://bugzilla.redhat.com/show_bug.cgi?id=1982743)
    # that makes it print malformed flows. This is a workaround just in case the running OVS version is not yet
    # fixed
    for file in $(ls -x ${RESTORE_FLOWS_DIR}/*flows.dump); do
        sed -i 's/igmp,/ip,nw_proto=2,/g' $file
    done
    # The final line generated by ovs-save removes the directory were the flows are stored. Just don't do it
    sed -i '/rm.*/d' ${RESTORE_FLOWS_DIR}/do_restore.sh

    # Collect the DB backup
    mkdir -p $VAR_RUN
    kubectl exec -i -n $OVN_NAMESPACE -c $container $ovnkube_node -- ovsdb-client backup > ${WORKDIR}/${ovnkube_node}_ovs.db
    do_collect-db ${WORKDIR}/${ovnkube_node}_ovs.db ovs

    # Collect OVN information
    #ovnkube_db_pod=$(kubectl get pods -n $OVN_NAMESPACE -o name | grep ovnkube-db | sed "s/^.\{4\}//")
    for dir in $OVN_DB_LOCATIONS; do
        if [ ! -f $WORKDIR/ovnnb_db.db ]; then
            kubectl cp -n ${OVN_NAMESPACE} -c nb-ovsdb ${ovnkube_node}:/${dir}/ovnnb_db.db ${WORKDIR}/ovnnb_db.db 2>&1 | grep -v 'tar: Removing leading' || true >&2
        fi
        if [ ! -f $WORKDIR/ovnsb_db.db ]; then
            kubectl cp -n ${OVN_NAMESPACE} -c sb-ovsdb ${ovnkube_node}:/${dir}/ovnsb_db.db  ${WORKDIR}/ovnsb_db.db 2>&1 | grep -v 'tar: Removing leading' || true >&2
        fi
    done
    [ -f $WORKDIR/ovnnb_db.db ] || log_error "Could not copy ovnnb_db.db from ${ovnkube_node}"
    [ -f $WORKDIR/ovnsb_db.db ] || log_error "Could not copy ovnsb_db.db from ${ovnkube_node}"
    do_collect-db ${WORKDIR}/ovnnb_db.db ovn_nb
    do_collect-db ${WORKDIR}/ovnsb_db.db ovn_sb
}

check_for_OpenFlow_14() {
    # If no protocol listed, default to atomic bundle txn (enabled by default on ovs 2.8 and on)
    local hex_ofp_version=$(cat ${SOS_CMD_DIR}/ovs-ofctl_-t_5_--version | grep "OpenFlow versions" | grep -oP [0-9]*x[0-9]* | tail -1)
    local version=${open_flow_protocols[$hex_ofp_version]}
    if [ -z "$version" ]; then
        echo " --bundle"
    else
        [ ${version#OpenFlow} -ge 14 ] && bundle=" --bundle" || bundle=""
        echo $bundle
    fi
}

do_collect-sos-ovn() {
    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi
    local sos=$1
    mkdir -p ${SOS_DIR}

    log_status "Extracting OVN data from sos report"
    local found_db=false
    for dir in $OVN_DB_LOCATIONS; do
        strip=$((2 + $(echo ${dir} | tr -dc "/" | wc -m)))
        if _sos-try-extract $sos ${dir}/ovnnb_db.db true &&
           _sos-try-extract $sos ${dir}/ovnsb_db.db true; then
            found_db=true
            do_collect-db "${SOS_DIR}/ovnnb_db.db" "ovn_nb"
            do_collect-db "${SOS_DIR}/ovnsb_db.db" "ovn_sb"
            rm ${SOS_DIR}/ovn*b_db.db
            break
        fi
    done

    if ! $found_db; then
        log_error "Could not extract both OVN database files"
    fi
}

_sos-try-extract() {
    # $1 path of the sos archive/dir to extract data from
    # $2 file or directory to extract 
    # $3 boolean ("true", "false) to define whether full stripping is done 
    #
    # Returns 0 if succeeded 1 if not.
    local sos=$1
    local src=$2
    local strip=$3

    if [[ -f ${sos} ]]; then
        # It's an archive file.
        # By default we always strip the first name which is typically the name of
        # the archive itself (i.e: dir_name)
        local dir_name=`tar -tf $sos | head -1 | cut -f1 -d"/"`
        local strip_level=1
        if [[ $strip == true ]]; then
            strip_level=$((1 + $(echo ${src} | tr -dc "/" | wc -m)))
        fi

        if tar -xvf $sos -C ${SOS_DIR} ${dir_name}/${src} --strip-components=${strip_level} &>/dev/null; then
            return 0
        else
            return 1
        fi
    elif [[ -d ${sos} ]]; then
        # In this case, dir_name are all the directories until we find sos_logs.
        local dir_name=$(dirname $(cd ${sos} && find -name sos_logs 2>/dev/null))
        if [[ $strip == true ]]; then
            cp -r ${sos}/${dir_name}/${src} ${SOS_DIR}
        else
            # Create parent directories
            local parent=$(dirname ${src})
            mkdir -p ${SOS_DIR}/${parent}
            cp -r ${sos}/${dir_name}/${src} ${SOS_DIR}/${parent}
        fi
    else
        log_error "SOS archive file or directory not found. Please specify a <sosreport>.tar.xz archive file or the directory of the extracted data."
    fi
}

do_collect-sos-ovs() {
    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi
    local sos=$1
    local sos_files="sos_commands/rpm sos_commands/openvswitch"
    local db_locations="var/lib/openvswitch etc/openvswitch usr/local/etc/openvswitch"

    mkdir -p ${SOS_DIR}

    log_status "Extracting OVS data from sos report"
    for dir in $sos_files; do
        _sos-try-extract $sos $dir false || log_error "Could not extract critical directory $dir from $sos"
    done

    found_db=false
    for dir in $db_locations; do
        if _sos-try-extract $sos $dir/conf.db true; then
            do_collect-db ${SOS_DIR}/conf.db ovs
            rm ${SOS_DIR}/conf.db
            found_db=true
            break
        fi
    done

    if ! $found_db; then
        log_warning "conf.db not found in default locations."
        log_info "If the target cluster has defined \$ovs_dbdir it could be located there"
        log_info "Please add manually using collect-db and re-run collect-sos"
    fi

    # OVS 2.7 and earlier do not enable OpenFlow 1.4 (by default) and lack
    # other features needed to save and restore flows.
    local ovs_ver=$(cat ${SOS_DIR}/sos_commands/rpm/package-data | grep -o ^openvswitch-[0-9].[0-9]*.[0-9])
    case $ovs_ver in
    "openvswitch-1."*.*)
        log_error "Outdated ovs version (2.8 or higher required)"
        ;;
    "openvswitch-2."[0-7].*)
        log_error "Outdated ovs version (2.8 or higher required)"
        ;;
    esac

    mkdir -p $RESTORE_FLOWS_DIR

    if test -f "${SOS_CMD_DIR}/ovs-vsctl_-t_5_list-br"; then
        bridges=$(cat ${SOS_CMD_DIR}/ovs-vsctl_-t_5_list-br)
    else
        log_error "ovs-vsctl_-t_5_list-br missing from sos report. Make sure your sos archive is generated from the most recent sos report"
    fi

    # Collect group, flow, and tlv dumps
    for br in $bridges; do
        local version=$(ls $SOS_CMD_DIR | grep ovs-ofctl_-O_OpenFlow[0-9]*_dump-flows_${br} | grep -o "OpenFlow[0-9]*")
        local high_ver=$(echo "$version" | sort | tail -n 1)
        cp ${SOS_CMD_DIR}/ovs-ofctl_-O_${high_ver}_dump-flows_${br} $RESTORE_FLOWS_DIR || log_error "Sos report missing dump-flows for bridge $br. Make sure your sos archive is generated from the most recent sos report"
        cp ${SOS_CMD_DIR}/ovs-ofctl_-O_${high_ver}_dump-tlv-map_${br} $RESTORE_FLOWS_DIR || log_error "Sos report missing dump-tlv for bridge $br. Make sure your sos archive is generated from the most recent sos report"
        cp ${SOS_CMD_DIR}/ovs-ofctl_-O_${high_ver}_dump-groups_${br} $RESTORE_FLOWS_DIR || log_error "Sos report missing dump-groups for bridge $br. Make sure your sos archive is generated from the most recent sos report"
    done
    # Apply the workarounds found in ovs-save to the current flows and
    # groups to allow for restoration
    for dump in ${RESTORE_FLOWS_DIR}/*dump-flows*; do
        sed -i -e '/NXST_FLOW/d' \
            -e '/OFPST_FLOW/d' \
            -e 's/\(idle\|hard\)_age=[^,]*,//g' \
            -e 's/igmp/ip,nw_proto=2/g' \
            "$dump"
    done

    for dump in ${RESTORE_FLOWS_DIR}/*dump-groups*; do
        sed -i -e '/^OFPST_GROUP_DESC/d' \
            -e '/^NXST_GROUP_DESC/d' \
            "$dump"
    done

    # If possible use OpenFlow 1.4 atomic bundle txn for flows and groups
    local bundle=$(check_for_OpenFlow_14)

    # Create restore.sh script
    echo "CURR_DIR=\$(dirname \$(realpath \$0))" >> ${RESTORE_FLOWS_DIR}/restore.sh
    for br in $bridges; do
        local flow_version=$(ls ${RESTORE_FLOWS_DIR}/ovs-ofctl_-O_OpenFlow[0-9]*_dump-flows_$br | grep -o OpenFlow[0-9]*)
        local group_version=$(ls ${RESTORE_FLOWS_DIR}/ovs-ofctl_-O_OpenFlow[0-9]*_dump-groups_$br | grep -o OpenFlow[0-9]*)
        echo -n "$(find_binary ovs-ofctl) add-tlv-map ${br} '" >> ${RESTORE_FLOWS_DIR}/restore.sh
        cat ${RESTORE_FLOWS_DIR}/ovs-ofctl_-O_OpenFlow[0-9]*_dump-tlv-map_$br | \
        awk '/^  *0x/ {if (cnt != 0) printf ","; \
            cnt++;printf "{class="$1",type="$2",len="$3"}->"$4}' >> ${RESTORE_FLOWS_DIR}/restore.sh
        echo "'" >> ${RESTORE_FLOWS_DIR}/restore.sh

        echo "$(find_binary ovs-ofctl) -O ${group_version} add-groups ${br} \
                    \"\$CURR_DIR/ovs-ofctl_-O_${group_version}_dump-groups_${br}\" ${bundle}" >> ${RESTORE_FLOWS_DIR}/restore.sh

        echo "$(find_binary ovs-ofctl) -O $flow_version replace-flows ${br} \
                    \"\$CURR_DIR/ovs-ofctl_-O_${flow_version}_dump-flows_${br}\" ${bundle}" >> ${RESTORE_FLOWS_DIR}/restore.sh
    done
}

start_ovsdb() {
    # run ovsdb-server
    # $1 : database_type (directory within $WORKDIR/db)
    local name=$1
    local remote_var_run
    if [ $name == "ovs" ] ; then
       remote_var_run=/usr/local/var/run/openvswitch
    else
       remote_var_run=/var/run/ovn
    fi
    local db_file=$(ls -x ${WORKDIR}/db/${name} | tail -1)
    local backup_local_file=${WORKDIR}/db/${name}/${db_file}

    local local_var_run=${VAR_RUN}/${name}
    mkdir -p ${local_var_run}

    local container_name=ovsdb-server-${name}
    local backup_file=${remote_var_run}/${name}.db
    local caps="--cap-add=CAP_SETGID --cap-add=CAP_SETUID --cap-add=CAP_SETPCAP --cap-add=CAP_NET_BIND_SERVICE --cap-add=CAP_IPC_LOCK"

    ${CONTAINER_CMD} kill ovsdb-server-${name} &>/dev/null || true
    ${CONTAINER_CMD} rm ovsdb-server-${name} &>/dev/null || true

    log_status "Starting container ovsdb-server-${name}"
    ${CONTAINER_CMD} run -d -e OVSDB_BACKUP=${backup_file} ${caps} -e UID=$(id -u) -e CONTAINER_TYPE=${CONTAINER_CMD} -v ${backup_local_file}:${backup_file} -v ${local_var_run}:${remote_var_run} --pid=host --name ovsdb-server-${name} ovs-offline __ovsdb-${name}
    sleep 3
}

start_vswitchd() {
    # run ovs-vswitchd
    local remote_var_run=/usr/local/var/run/openvswitch
    local socket_file=${remote_var_run}/db.sock
    local local_var_run=${VAR_RUN}/ovs
    mkdir -p ${local_var_run}

    local caps="--cap-add=CAP_SETGID --cap-add=CAP_SETUID --cap-add=CAP_SETPCAP --cap-add=IPC_LOCK --cap-add=NET_ADMIN --cap-add=NET_BROADCAST"
    ${CONTAINER_CMD} kill ovs-vswitchd &>/dev/null || true
    ${CONTAINER_CMD} rm ovs-vswitchd &>/dev/null || true

    log_status "Starting container ovs-vswitchd"
    ${CONTAINER_CMD} run -d -e OVSDB_SOCKET=${socket_file} ${caps} -e UID=$(id -u) -e RESTORE_DIR="/root/restore_flows" -e CONTAINER_TYPE=${CONTAINER_CMD} -v ${RESTORE_FLOWS_DIR}:"/root/restore_flows" -v ${local_var_run}:${remote_var_run} --pid=host --name ovs-vswitchd ovs-offline __vswitchd-dummy
    sleep 3
}

start_ovsdb_standalone() {
    # run ovsdb-server directly on host (standalone mode)
    # $1 : database_type (directory within $WORKDIR/db)
    local name=$1
    local db_file=$(ls -x ${WORKDIR}/db/${name} | tail -1)
    local backup_local_file=${WORKDIR}/db/${name}/${db_file}
    
    log_status "Starting standalone ovsdb-server for ${name}"
    
    # Set environment variables for __ovsdb function
    export OVSDB_BACKUP=${backup_local_file}
    export OVS_RUNDIR=${VAR_RUN}/${name}
    export STANDALONE_MODE=true
    mkdir -p ${OVS_RUNDIR}
    
    # Call the internal __ovsdb function (daemon will detach itself)
    __ovsdb ${name}
    sleep 1
}

start_vswitchd_standalone() {
    # run ovs-vswitchd directly on host (standalone mode)
    log_status "Starting standalone ovs-vswitchd"
    
    # Set environment variables for __vswitchd-dummy function
    export OVSDB_SOCKET=${VAR_RUN}/ovs/db.sock
    export RESTORE_DIR=${RESTORE_FLOWS_DIR}
    export STANDALONE_MODE=true
    
    # Call the internal __vswitchd-dummy function (daemon will detach itself)
    __vswitchd-dummy
    sleep 1
}

do_start() {
    local standalone=false

    # Parse options for start command
    OPTIND=1
    while getopts "sr:" opt; do
        case ${opt} in
            s)
                standalone=true
                ;;
            r)
                RPM_PATHS="$OPTARG"
                ;;
        esac
    done
    shift $((OPTIND-1))
    
    # Ensure ovs-offline collect ovs or ovn has been run
    if [ ! "$(ls -A ${RESTORE_FLOWS_DIR} 2> /dev/null)" ] && [ ! "$(ls -A ${WORKDIR}/db/ 2> /dev/null)" ]; then
        log_error "Restoration data not found in ${WORKDIR}. Please run ovs-offline collect-... first"
    fi

    if [ "$standalone" = true ]; then
            log_info "Standalone mode (no containers)"

        # Extract RPMs if provided
        if [ -n "$RPM_PATHS" ]; then
            extract_rpms "$RPM_PATHS"
        fi

        # Check for required OVS binaries
        for binary in ovsdb-server ovsdb-tool ovs-vswitchd ovs-vsctl; do
            if ! find_binary $binary >/dev/null; then
                log_error "Required binary '$binary' not found. Please install OVS tools or use container mode."
            fi
        done
        
        mkdir -p $VAR_RUN
        for db_type in $(ls -x ${WORKDIR}/db); do
            start_ovsdb_standalone ${db_type}
            if [ ${db_type} == "ovs" ] && [ -d ${RESTORE_FLOWS_DIR} ]; then
                start_vswitchd_standalone
            fi
        done
    else
        log_info "Container mode"
        set_container_cmd
        # Ensure ovs-offline image is present
        ${CONTAINER_CMD} inspect ovs-offline 2>&1 >/dev/null || (
            log_warning "Failed to find a local container named ovs-offline. Pulling from quay.io/amorenoz/ovs-offline"
            log_info "Pulling container image from quay.io/amorenoz/ovs-offline"
            ${CONTAINER_CMD} pull quay.io/amorenoz/ovs-offline && ${CONTAINER_CMD} tag quay.io/amorenoz/ovs-offline ovs-offline
        )

        mkdir -p $VAR_RUN
        for db_type in $(ls -x ${WORKDIR}/db); do
            start_ovsdb ${db_type}
            if [ ${db_type} == "ovs" ] && [ test -d ${RESTORE_FLOWS_DIR} ]; then
                start_vswitchd
            fi
        done
    fi
}

generate_cmd_script() {
    mkdir -p $SOURCE_DIR
    # Create activate script that can be sourced to run OVS/OVN utilities using the files in $WORKDIR
    cat <<EOF > ${SOURCE_DIR}/activate
if [ "\${BASH_SOURCE-}" = "\$0" ]; then
    echo "You must source this script: \\\$ source \$0" >&2
    exit 33
fi

declare -a ovs_offline_aliased
declare -A ovs_offline_cmds

old_path=\$PATH
old_ld_path=\$LD_LIBRARY_PATH 

ovs-offline-deactivate() {
    if ! [ -z "\${OLD_PS1+_}" ] ; then
        PS1="\$OLD_PS1"
        export PS1
        unset OLD_PS1
    fi
    for env in OVS_RUNDIR OVN_SB_DB OVN_NB_DB; do
        old_var="OLD_\${env}"
        if [ ! -z \${!old_var} ]; then
            export \${env}=\${!old_var}
            unset \${old_var}
        else
            unset \${env}
        fi
    done
    for cmd in \${ovs_offline_aliased[@]}; do
        unalias \$cmd
    done
    unset ovs_offline_aliased
    unset OVS_OFFLINE_ENV
    PATH=\$old_path
    if [ -z "\$old_ld_path" ]; then
        unset LD_LIBRARY_PATH
    else
        LD_LIBRARY_PATH=\$old_ld_path
    fi
}

if [ -z "\${OVS_OFFLINE_ENV}" ] ; then
    OLD_PS1="\${PS1-}"
    PS1="(`basename ovs-offline`) \${PS1-}"
    export PS1
fi

ovs_offline_cmds[ovsdb-server-ovs]="ovs-vsctl"
ovs_offline_cmds[ovs-vswitchd]="ovs-ofctl ovs-appctl"
ovs_offline_cmds[ovsdb-server-ovn_nb]="ovn-nbctl"
ovs_offline_cmds[ovsdb-server-ovn_sb]="ovn-sbctl"

# Alias ovs commands if needed.
unset command_not_found_handle
if [ -n "$RPM_PATHS" ] && [ -d "$EXTRACTED_RPMS_DIR" ]; then
    PATH="$EXTRACTED_RPMS_DIR/usr/bin:\$PATH"
    export LD_LIBRARY_PATH="$(get_ld_library_path):\$PATH"
else
    for container in "\${!ovs_offline_cmds[@]}"; do
        if ${CONTAINER_CMD} inspect \$container &> /dev/null; then
            for cmd in \${ovs_offline_cmds[\$container]}; do
                if ! \$(\$cmd --version &> /dev/null); then
                    alias \$cmd="${CONTAINER_CMD} exec -it \$container \$cmd"
                    ovs_offline_aliased+=(\$cmd)
                fi
            done
        fi
    done
fi

echo "* You can now run the following offline commands directly:"
if [ ! -z \${OVS_RUNDIR} ] && [ -z "\${OVS_OFFLINE_ENV}" ]; then
  OLD_OVS_RUNDIR=\$OVS_RUNDIR
fi
export OVS_RUNDIR=${VAR_RUN}/ovs
EOF

    if ls -x ${VAR_RUN}/ovs/ovs-vswitchd.*.ctl &>/dev/null; then
        local vswitchd_ctl=$(ls -x ${VAR_RUN}/ovs/ovs-vswitchd.*.ctl)
        cat <<EOF >> ${SOURCE_DIR}/activate
echo "      ovs-appctl [...]"
echo ''
EOF
    fi

    for type in ovs ovn_nb ovn_sb; do
        if ls -x ${VAR_RUN}/${type}/*.sock &>/dev/null; then
            local db_sock=$(ls -x ${VAR_RUN}/${type}/*.sock)
            case ${type} in
                ovs)
                    local command="ovs-vsctl"
                    ;;
                ovn_nb)
                    local command="ovn-nbctl"
                    local db_alias='\$OVN_NB_DB'
                    cat <<EOF >> ${SOURCE_DIR}/activate
if [ ! -z \${OVN_NB_DB} ] && [ -z "\${OVS_OFFLINE_ENV}" ]; then
    OLD_OVN_NB_DB=\$OVN_NB_DB
fi
export OVN_NB_DB=unix:${db_sock}
EOF
                    ;;
                ovn_sb)
                    local command="ovn-sbctl"
                    local db_alias='\$OVN_SB_DB'
                    cat <<EOF >> ${SOURCE_DIR}/activate
if [ ! -z \${OVN_SB_DB} ] && [ -z "\${OVS_OFFLINE_ENV}" ]; then
    OLD_OVN_SB_DB=\$OVN_SB_DB
fi
export OVN_SB_DB=unix:${db_sock}
EOF
                    ;;
                *)
                    log_error "Unkown db socket file ${db_sock}"
            esac
            cat <<EOF >> ${SOURCE_DIR}/activate
echo "      ${command} [...]"
echo "      ovsdb-client [...] ${db_alias-} "
echo ''
EOF
        fi
    done

    if ls -x ${VAR_RUN}/ovs/*.mgmt &>/dev/null; then
        echo "echo '      ovs-ofctl [...] [bridge]'" >> ${SOURCE_DIR}/activate
    fi
    cat <<EOF >> ${SOURCE_DIR}/activate
echo "* You can restore your previous environment with: "
echo "      ovs-offline-deactivate"
export OVS_OFFLINE_ENV="true"
EOF
}

print_tools() {
    log_info "Working directory: $WORKDIR"

    if ls -x $VAR_RUN/ovs/ovs-vswitchd.*.ctl &>/dev/null; then
        vswitchd_ctl=$(ls -x $VAR_RUN/ovs/ovs-vswitchd.*.ctl)
        echo ""
        log_info "openvswitch control found at ${vswitchd_ctl}"
        echo "  You can run ovs-appctl commands as:"
        echo "      ovs-appctl --target=${vswitchd_ctl} [...]"
    fi

    for type in ovs ovn_nb ovn_sb; do
        if ls -x ${VAR_RUN}/${type}/*.sock &>/dev/null; then
            db_sock=$(ls -x $VAR_RUN/${type}/*.sock)
            command=""
            case ${type} in
                ovs)
                    command="ovs-vsctl"
                    ;;
                ovn_nb)
                    command="ovn-nbctl"
                    ;;
                ovn_sb)
                    command="ovn-sbctl"
                    ;;
                *)
                    log_error "Unkown db socket file ${db_sock}"
            esac
            echo ""
            log_info "${type} ovsdb-server socket found at ${db_sock}"
            echo "  You can run commands such as:"
            echo "      ${command} --db unix:${db_sock} [...]"
            echo "  or"
            echo "      ovsdb-client [...] unix:${db_sock} "
        fi
    done

    if ls -x $VAR_RUN/ovs/*.mgmt &>/dev/null; then
        ofproto_socks=$(ls -x $VAR_RUN/ovs/*.mgmt)
        echo ""
        log_info "openflow bridge management sockets found at ${ofproto_socks}"
        echo "  You can run ofproto commands such as:"
        for mgt in $(ls -x $VAR_RUN/ovs/*.mgmt); do
            echo "      ovs-ofctl [...] ${mgt}"
        done
    fi

    echo ""
    log_info "You can also run offline commands directly with the following:"
    echo "    source ${SOURCE_DIR}/activate"
}

# Container-internal functions (prefixed with __ for internal use only)
# These are called when ovs-offline runs inside a container

__vswitchd-dummy() {
    log_status "Starting vswitchd-dummy"
    OVSDB_SOCKET=${OVSDB_SOCKET:-/usr/local/var/run/openvswitch/db.sock}
    log_info "RESTORE_DIR=${RESTORE_DIR}"

    (
    log_status "Waiting for ovs-vswitchd to start..."
    sleep 5

    if [ -d "${RESTORE_DIR}" ]; then
        log_status "Restoring flows"
        sed -i "s:ovs-ofctl:$(find_binary ovs-ofctl):g" ${RESTORE_DIR}/do_restore.sh
        sh -e ${RESTORE_DIR}/restore.sh
    fi
    ) &

    if [ "${CONTAINER_TYPE:-}" == docker ]; then
        if [ "$UID" -eq 0 ] || [ -z "${UID}" ]; then
            container_user=root
        else
            useradd new_user -u $UID
            chown -R new_user /usr/local/var/run/openvswitch/
            container_user=new_user
        fi
        user_opt="--user ${container_user}"
    fi

    # Replace DPDK netdevs with dummy ones
    for netdev in dpdk dpdkvhostuser dpdkvhostuserclient; do
        for iface in $(ovs-vsctl --format json --columns=_uuid find Interface type=${netdev} | jq -r '.data[][0][1]'); do
            ovs-vsctl --no-wait set Interface $iface type=dummy;
        done
    done

    if [ "${STANDALONE_MODE:-}" = "true" ]; then
        # Standalone mode: log to file, run in background
        mkdir -p ${VAR_RUN}/ovs
        VSWITCHD_PIDFILE=${VAR_RUN}/ovs/ovs-vswitchd.pid
        VSWITCHD_LOGFILE=${VAR_RUN}/ovs/ovs-vswitchd.log
        log_info "Logging to: $VSWITCHD_LOGFILE"
        $(find_binary ovs-vswitchd) ${user_opt-} --enable-dummy=override -vvconn -vnetdev_dummy --no-chdir --pidfile=${VSWITCHD_PIDFILE} --log-file=${VSWITCHD_LOGFILE} --detach -vsyslog:off unix:${OVSDB_SOCKET}
    else
        # Container mode: log to stdout for podman/docker logs
        ovs-vswitchd ${user_opt-} --enable-dummy=override -vvconn -vnetdev_dummy  --no-chdir --pidfile  -vsyslog:off unix:${OVSDB_SOCKET}
    fi
}

__set_runtime_vars() {
    local db_type=$1

    case $db_type in
        ovs)
            OVS_RUNDIR=${OVS_RUNDIR:-/usr/local/var/run/openvswitch/}
            OVSDB_SOCKET=$OVS_RUNDIR/db.sock
            OVSDB_PIDFILE=$OVS_RUNDIR/ovsdb-server.pid
            OVSDB_BACKUP=${OVSDB_BACKUP:-${OVS_RUNDIR}/conf.db}
            OVSDB_REMOTE=ptcp:6640
            # Use local file path for standalone mode, system path for container mode
            if [ -z "${STANDALONE_MODE}" ]; then
                OVSDB_FILE=/usr/local/etc/openvswitch/conf.db
            else
                OVSDB_FILE=${OVS_RUNDIR}/conf.db
            fi
            ;;
        ovn_nb)
            OVS_RUNDIR=${OVS_RUNDIR:-/var/run/ovn/}
            OVSDB_SOCKET=$OVS_RUNDIR/ovnnb_db.sock
            OVSDB_PIDFILE=$OVS_RUNDIR/ovnnb_db.pid
            OVSDB_BACKUP=${OVSDB_BACKUP:-${OVS_RUNDIR}/ovn_nb.db}
            OVSDB_REMOTE=ptcp:6641
            # Use local file path for standalone mode, system path for container mode
            if [ -z "${STANDALONE_MODE}" ]; then
                OVSDB_FILE=/usr/local/etc/openvswitch/ovn_nb.db
            else
                OVSDB_FILE=${OVS_RUNDIR}/ovn_nb.db
            fi
            ;;
        ovn_sb)
            OVS_RUNDIR=${OVS_RUNDIR:-/var/run/ovn/}
            OVSDB_SOCKET=$OVS_RUNDIR/ovnsb_db.sock
            OVSDB_PIDFILE=$OVS_RUNDIR/ovnsb_db.pid
            OVSDB_BACKUP=${OVSDB_BACKUP:-${OVS_RUNDIR}/ovn_sb.db}
            OVSDB_REMOTE=ptcp:6642
            # Use local file path for standalone mode, system path for container mode
            if [ -z "${STANDALONE_MODE}" ]; then
                OVSDB_FILE=/usr/local/etc/openvswitch/ovn_sb.db
                mkdir -p /etc/openvswitch
            else
                OVSDB_FILE=${OVS_RUNDIR}/ovn_sb.db
            fi
            ;;
        *)
            log_error "Unknown database type: $db_type"
            exit 1
            ;;
    esac
}

__ovsdb() {
    local db_type=$1
    __set_runtime_vars $db_type
    __do_ovsdb
}

__do_ovsdb() {
    log_status "Starting ovsdb-server"
    log_info "OVSDB_BACKUP=$OVSDB_BACKUP"

    mkdir -p $(dirname $OVSDB_FILE)
    if [ -f ${OVSDB_BACKUP} ]; then
        log_info "Using backup DB file at $OVSDB_BACKUP"

        log_status "Making a standalone DB if needed"
        $(find_binary ovsdb-tool) cluster-to-standalone $OVSDB_FILE $OVSDB_BACKUP || cp $OVSDB_BACKUP $OVSDB_FILE
        log_status "Compacting DB"
        $(find_binary ovsdb-tool) compact $OVSDB_FILE
    else
        log_info "Creating new DB"
        $(find_binary ovsdb-tool) create $OVSDB_FILE  /usr/local/share/openvswitch/vswitch.ovsschema
    fi

    if [ "${CONTAINER_TYPE:-}" == docker ]; then
        if [ "$UID" -eq 0 ] || [ -z "${UID}" ]; then
            container_user=root
        else
            useradd new_user -u $UID
            chown -R new_user /usr/local/var/run/openvswitch/ /usr/local/etc/openvswitch/
            container_user=new_user
        fi
        user_opt="--user ${container_user}"
    fi

    if [ "${STANDALONE_MODE:-}" = "true" ]; then
        # Standalone mode: log to file, run in background
        mkdir -p $(dirname ${OVSDB_PIDFILE})
        OVSDB_LOGFILE=$(dirname ${OVSDB_PIDFILE})/ovsdb-server.log
        log_info "Logging to: $OVSDB_LOGFILE"
        $(find_binary ovsdb-server) ${user_opt-} --remote=punix:${OVSDB_SOCKET} --remote=${OVSDB_REMOTE} --pidfile=${OVSDB_PIDFILE} --log-file=${OVSDB_LOGFILE} --detach $OVSDB_FILE
    else
        # Container mode: log to stdout for podman/docker logs
        ovsdb-server ${user_opt-} --remote=punix:${OVSDB_SOCKET} --remote=${OVSDB_REMOTE} --pidfile=${OVSDB_PIDFILE} $OVSDB_FILE
    fi
}

while getopts ":hdw:p" opt; do
    case ${opt} in
        h)
            usage
            exit 0
            ;;
        w)
            WORKDIR=$(realpath $OPTARG)
            VAR_RUN=${WORKDIR}/var-run
            SOS_DIR=${WORKDIR}/sos_report
            SOS_CMD_DIR=${SOS_DIR}/sos_commands/openvswitch/
            SOURCE_DIR=${WORKDIR}/bin
            RESTORE_FLOWS_DIR=${WORKDIR}/restore_flows
            ;;
        d)
            set -x
            ;;
    esac
done

shift $(((OPTIND -1)))
if [ $# -lt 1 ]; then
    usage
    exit 1
fi
CMD=$1
shift

mkdir -p ${WORKDIR}

case $CMD in
    collect-k8s)
        do_collect-k8s $@
        echo ""
        log_complete "Offline OVS Debugging: data collected and stored in ${WORKDIR}"
        ;;
    collect-sos-ovs)
        do_collect-sos-ovs $@
        echo ""
        log_complete "Offline OVS Debugging: OVS data collected and stored in ${WORKDIR}"
        ;;
    collect-sos-ovn)
        do_collect-sos-ovn $@
        echo ""
        log_complete "Offline OVS Debugging: OVN data collected and stored in ${WORKDIR}"
        ;;
    collect-db-ovs)
        do_collect-db $@ "ovs"
        echo ""
        log_complete "Offline OVS Debugging: OVS DB file collected and stored in ${WORKDIR}"
        ;;
    collect-db-ovn-nb)
        do_collect-db $@ "ovn_nb"
        echo ""
        log_complete "Offline OVS Debugging: OVN NB DB file collected and stored in ${WORKDIR}"
        ;;
    collect-db-ovn-sb)
        do_collect-db $@ "ovn_sb"
        echo ""
        log_complete "Offline OVS Debugging: OVN SB DB file collected and stored in ${WORKDIR}"
        ;;
    build)
        do_build $@
        log_complete "Offline OVS Debugging: images built"
        ;;
    start)
        do_start $@
        echo ""
        log_complete "Offline OVS Debugging started"
        echo ""
        print_tools
        generate_cmd_script
        ;;
    show)
        print_tools
        ;;
    stop)
        do_stop $@
        log_complete "Offline OVS Debugging stopped"
        ;;
# The following commands are used inside the container, thus undocumented.
    __vswitchd-dummy)
        __vswitchd-dummy
        ;;
    __ovsdb-ovs)
        __ovsdb ovs
        ;;
    __ovsdb-ovn_nb)
        __ovsdb ovn_nb
        ;;
    __ovsdb-ovn_sb)
        __ovsdb ovn_sb
        ;;
    __sleep)
        sleep infinity 
        ;;
    *)
        echo "Invalid command $CMD" 1>&2
        exit 1
        ;;
esac
